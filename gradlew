#!/bin/sh

##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
PRG="$0"
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
case "`uname`" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MINGW* | MSYS* )
    msys=true
    ;;
esac

# Helper to read Java major version (returns 0 if unknown)
get_java_major () {
    ver=`"$1" -version 2>&1 | sed -n 's/.*version "\([0-9]*\)\..*".*/\1/p' | head -n 1`
    if [ -z "$ver" ]; then
        ver=`"$1" -version 2>&1 | sed -n 's/.*version "\([0-9]*\)".*/\1/p' | head -n 1`
    fi
    case "$ver" in
        1)
            ver=`"$1" -version 2>&1 | sed -n 's/.*version "1\.\([0-9]*\).*/\1/p' | head -n 1`
            ;;
    esac
    echo "${ver:-0}"
}

# Determine the Java command to use to start the JVM.
JAVACMD=""
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation (JDK 17 or 21 recommended)."
    fi
else
    JAVACMD=`which java 2>/dev/null`
fi

# Check if active Java is missing or unsupported (> 21 for Gradle 8.7); fallback to JDK 17/21 if available
active_major=0
if [ -n "$JAVACMD" ]; then
    active_major=`get_java_major "$JAVACMD"`
fi

if [ "$active_major" -eq 0 ] || [ "$active_major" -gt 21 ]; then
    for candidate in \
        "/d/jdk-21.0.5" \
        "/c/Program Files/JetBrains/IntelliJ IDEA 2024.3.7/jbr" \
        "/c/Program Files/Android/Android Studio/jbr" \
        "/d/Studio/jbr" \
        /c/Program\ Files/Eclipse\ Adoptium/jdk-21* \
        /c/Program\ Files/Eclipse\ Adoptium/jdk-17* \
        /c/Program\ Files/Java/jdk-21* \
        /c/Program\ Files/Java/jdk-17*
    do
        if [ -x "$candidate/bin/java" ]; then
            cand_major=`get_java_major "$candidate/bin/java"`
            if [ "$cand_major" -ge 17 ] && [ "$cand_major" -le 21 ]; then
                export JAVA_HOME="$candidate"
                JAVACMD="$candidate/bin/java"
                active_major="$cand_major"
                break
            fi
        fi
    done
fi

if [ -z "$JAVACMD" ]; then
    die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation (JDK 17 or 21)."
fi

if [ "$active_major" -gt 21 ]; then
    die "ERROR: Active Java version is $active_major, which is not supported by Gradle 8.7.
Please set JAVA_HOME to JDK 17 or JDK 21 before running ./gradlew."
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ "$cygwin" = "true" ] || [ "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    if [ -n "$JAVA_HOME" ]; then
        export JAVA_HOME=`cygpath --mixed "$JAVA_HOME"`
    fi
fi

eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=$APP_BASE_NAME\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "\"\$@\""

exec "$JAVACMD" "$@"

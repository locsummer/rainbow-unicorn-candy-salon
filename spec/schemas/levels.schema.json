{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LevelsConfiguration",
  "type": "object",
  "required": ["version", "levels"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "levels": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "theme",
          "characterType",
          "requiresPremium",
          "stations",
          "criteria"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 20 },
          "name": { "type": "string", "minLength": 1 },
          "theme": { "type": "string" },
          "characterType": { "type": "string", "enum": ["unicorn", "princess"] },
          "requiresPremium": { "type": "boolean" },
          "stations": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": ["spa", "hair", "makeup", "dressup", "cake", "pet", "photo"]
            }
          },
          "criteria": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["id", "station", "type", "target", "description"],
              "properties": {
                "id": { "type": "string" },
                "station": { "type": "string" },
                "type": { "type": "string" },
                "target": {},
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
